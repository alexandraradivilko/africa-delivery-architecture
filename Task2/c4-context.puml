@startuml
!include <C4/C4_Context>
title Africa Delivery — контекст предлагаемого MVP
Person(buyer, "Покупатель", "Просматривает товары, покупает, отслеживает заказ")
Person(seller, "Продавец", "Передаёт предложения, получает статусы и выплаты")
Person(ops, "Оператор", "Проверяет продавцов и товары, разбирает споры и возвраты")
Person(ceo, "CEO / инвестор", "Получает показатели продаж")
System(ad, "Africa Delivery", "Каталог, заказ, координация оплаты и доставки, операции и уведомления")
System_Ext(mpesa, "M-Pesa", "Оплата в Кении; договор и интеграция требуют проверки")
System_Ext(flutter, "Flutterwave", "Оплата в Нигерии; договор и интеграция требуют проверки")
System_Ext(paystack, "Paystack", "Кандидат на последующий / резервный канал, вне MVP")
System_Ext(sendbox, "Sendbox", "Кандидат доставки в Нигерии; покрытие проверить")
System_Ext(sendy, "Sendy", "Кандидат из условия для Кении; доступность проверить")
System_Ext(wa, "WhatsApp Business API", "Уведомления и канал связи с продавцом; после проверки основания")
System_Ext(sms, "SMS/USSD-шлюз", "SMS в MVP; интерактивные USSD-заказы отложены")
Rel(buyer, ad, "Ищет, оформляет заказ, смотрит статус, обращается за возвратом", "HTTPS / PWA")
Rel(seller, ad, "Передаёт каталог и получает сведения о заказах через оператора")
Rel(ops, ad, "Модерирует, проверяет, выполняет сверку и возвраты", "HTTPS")
Rel(ceo, ad, "Смотрит согласованные показатели", "HTTPS")
Rel(ad, mpesa, "Создаёт платёж, запрашивает статус; получает callback", "API / webhook")
Rel(ad, flutter, "Создаёт платёж/возврат, сверяет статус; получает callback", "API / webhook")
Rel(ad, paystack, "Планируемая интеграция, не включена в запуск", "API")
Rel(ad, sendbox, "Передаёт доставку и получает статус после заключения договора", "API")
Rel(ad, sendy, "Предполагаемый обмен доставками; партнёр пока не подтверждён", "API")
Rel(ad, wa, "Отправляет разрешённые уведомления", "API")
Rel(seller, wa, "Общается с оператором по подтверждённому каналу")
Rel(ad, sms, "Отправляет SMS и получает статус доставки", "API")
Rel(sms, buyer, "Доставляет SMS")
note right of ad
  Граница системы не разрешает трансграничную передачу данных.
  Размещение и каждый внешний поток проверяются в задании 4.
  Названия партнёров взяты из кейса, договоры не подтверждены.
end note
SHOW_LEGEND()
@enduml
